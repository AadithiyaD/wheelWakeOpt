FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 1.08e-4;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           uniform 1.08e-4;
    }
    outlet
    {
        type            zeroGradient;
    }
    "(wheel|contactPatchSide)"
    {
        type            epsilonWallFunction;
        value           $internalField;
    }
    ground
    {
        type            epsilonWallFunction;
        value           uniform 1.08e-4;
    }
    "(top|side1)"
    {
        type            zeroGradient;
    }
    symmetry
    {
        type            symmetry;
    }
}


